# Ignore everything, then allow only deliverable directories and file types.
*
!*/

# Allow safe file types.
!/*.md
!/local/*.md
!*.hcl
!*.sh
!*.sql
!*.tf
!*.tftpl
!*.yaml

# Allow files without a safely generalizable type.
!/.gitignore
!/Makefile
!/assignment.txt
!/local/.env

# Exclude Terraform overrides and working directories after allowing Terraform types.
override.tf*
*_override.tf*
**/.terraform/

# Include the supplied WordPress tree.
!app/**

# Exclude its source archive; the extracted tree is canonical.
app/latest.tar.gz

# Exclude private key material. WordPress legitimately includes a CA certificate.
app/**/*.pem
app/**/*.key
app/**/*.csr
