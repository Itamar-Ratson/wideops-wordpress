# Ignore everything, then whitelist the deliverable.
*
!*/

# Allow: files
!.gitignore
!README.md
!Makefile
!assignment.txt
!data/wordpress.sql
!data/rewrite-urls.sql
!.terraform.lock.hcl

# Allow: directories
!scripts/**
!local/**

# Allow: types
!*.tf
!*.tftpl

# Deny: files
override.tf*
*_override.tf*

# Deny: directories
**/.terraform/

# Deny: types
*.pem
*.key
*.crt
*.csr

# Order-sensitive tail: each rule outranks everything above it.

# The supplied WordPress tree, unmodified.
!app/**
# ...except the source archive; the extracted tree is canonical.
app/latest.tar.gz
