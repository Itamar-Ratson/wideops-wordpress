# Ignore everything, then whitelist the deliverable.
*
!*/

# Allow: files
!.gitignore
!README.md
!Makefile
!compose.yaml
!assignment.txt
!data/wordpress.sql
!data/rewrite-urls.sql
!.terraform.lock.hcl

# Allow: directories
!scripts/**

# Allow: types
!*.tf

# Deny: files
override.tf*
*_override.tf*

# Deny: directories
**/.terraform/

# Deny: types
*.pem
*.key
*.crt
*.csr

# Supplied WordPress tree, unmodified. Last: outranks *.crt above.
!app/**
