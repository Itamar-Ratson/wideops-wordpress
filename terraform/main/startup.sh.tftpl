#!/bin/bash
# shellcheck disable=SC2154 # Terraform renders the named template variables.
set -euo pipefail

# Preserve the complete boot record in a file and syslog. The Ops Agent ships
# syslog to Cloud Logging once it is installed below.
exec > >(tee -a /var/log/wordpress-startup.log | logger --tag wordpress-startup) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq curl docker.io docker-compose-v2
systemctl enable --now docker

# Installing the agent is idempotent: the repository script and apt converge
# on the already-installed package when this startup script is run again.
curl -fsSL -o /tmp/add-google-cloud-ops-agent-repo.sh \
  https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
bash /tmp/add-google-cloud-ops-agent-repo.sh --also-install
systemctl enable --now google-cloud-ops-agent
rm -f /tmp/add-google-cloud-ops-agent-repo.sh

# Authenticate Docker with a short-lived token issued to this VM's service
# account. This avoids assuming that gcloud is installed on the base image.
TOKEN="$(curl -fsS \
  -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
  | sed -n 's/.*"access_token": *"\([^"]*\)".*/\1/p')"
test -n "$TOKEN"
printf '%s' "$TOKEN" | docker login \
  --username oauth2accesstoken \
  --password-stdin \
  "https://${artifact_registry_host}"
unset TOKEN

# The proxy writes the socket here as uid 33, so the directory must already be
# owned by it. This lives on tmpfs and is recreated on every boot, which is
# what a socket directory should do.
install -d -o 33 -g 33 -m 0755 /var/run/wordpress-mysqld

install -d -m 0755 /opt/wordpress
cat > /opt/wordpress/compose.yaml <<'COMPOSE'
${compose_file}
COMPOSE

# Compose converges on the declared state, so re-running this script needs no
# teardown step first. --wait blocks until the app healthcheck passes, which
# proves WordPress reached the database rather than merely that a port is open.
docker compose --file /opt/wordpress/compose.yaml up --detach --wait
