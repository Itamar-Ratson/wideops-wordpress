#!/bin/bash
# shellcheck disable=SC1091,SC2154
# The base image supplies /etc/os-release; Terraform renders template variables.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq ca-certificates curl docker.io docker-compose-v2 gnupg
systemctl enable --now docker

# GCS FUSE is installed from Google's signed apt repository. Rewriting the
# source and key is safe when the startup script is run again.
. /etc/os-release
curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
  | gpg --dearmor --yes --output /usr/share/keyrings/cloud.google.gpg
printf 'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt gcsfuse-%s main\n' \
  "$VERSION_CODENAME" > /etc/apt/sources.list.d/gcsfuse.list
apt-get update -qq
apt-get install -y -qq gcsfuse

# Authenticate Docker with a short-lived token issued to this VM's service
# account. This avoids assuming that gcloud is installed on the base image.
TOKEN="$(curl -fsS \
  -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
  | sed -n 's/.*"access_token": *"\([^"]*\)".*/\1/p')"
printf '%s' "$TOKEN" | docker login \
  --username oauth2accesstoken \
  --password-stdin \
  "https://${artifact_registry_host}"
unset TOKEN

# The proxy writes the socket here as uid 33, so the directory must already be
# owned by it. This lives on tmpfs and is recreated on every boot, which is
# what a socket directory should do.
install -d -o 33 -g 33 -m 0755 /var/run/wordpress-mysqld

# The bucket stores objects under the same wp-content/uploads prefix used by
# public URLs, but only that prefix is exposed inside the container. Root owns
# the FUSE process; uid/gid 33 present files as www-data, and allow_other lets
# Apache cross FUSE's default mounting-user boundary.
install -d -m 0755 /mnt/wordpress-uploads
gcsfuse \
  --implicit-dirs \
  --only-dir wp-content/uploads \
  --uid 33 \
  --gid 33 \
  -o allow_other \
  "${uploads_bucket_name}" \
  /mnt/wordpress-uploads

install -d -m 0755 /opt/wordpress
cat > /opt/wordpress/compose.yaml <<'COMPOSE'
${compose_file}
COMPOSE

# Compose converges on the declared state, so re-running this script needs no
# teardown step first. --wait blocks until the app healthcheck passes.
docker compose --file /opt/wordpress/compose.yaml up --detach --wait
