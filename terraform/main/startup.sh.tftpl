#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq ca-certificates curl docker.io docker-compose-v2 gnupg
systemctl enable --now docker

. /etc/os-release
curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
  | gpg --dearmor --yes --output /usr/share/keyrings/cloud.google.gpg
printf 'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt gcsfuse-%s main\n' \
  "$VERSION_CODENAME" > /etc/apt/sources.list.d/gcsfuse.list
apt-get update -qq
apt-get install -y -qq gcsfuse

TOKEN="$(curl -fsS \
  -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
  | sed -n 's/.*"access_token": *"\([^"]*\)".*/\1/p')"
printf '%s' "$TOKEN" | docker login \
  --username oauth2accesstoken \
  --password-stdin \
  "https://${artifact_registry_host}"
unset TOKEN

install -d -m 0755 /mnt/wordpress-uploads
# Keep allow_other: Apache cannot cross GCS FUSE mounting-user boundary without it.
gcsfuse \
  --implicit-dirs \
  --only-dir wp-content/uploads \
  --uid 33 \
  --gid 33 \
  -o allow_other \
  "${uploads_bucket_name}" \
  /mnt/wordpress-uploads

install -d -m 0755 /opt/wordpress
cat > /opt/wordpress/compose.yaml <<'COMPOSE'
${compose_file}
COMPOSE
cat > /opt/wordpress/.env <<'COMPOSE_ENV'
${environment_file}
COMPOSE_ENV

cd /opt/wordpress
docker compose --file compose.yaml up --detach --wait
